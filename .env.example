# Copy this file to .env and fill in the values. Never commit .env.
# Names starting with VITE_ are visible in the browser, so never put secrets in them.

# Frontend (safe for the browser)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend only (serverless functions)
SUPABASE_SERVICE_ROLE_KEY=
EMAIL_API_KEY=
TEAM_NOTIFICATION_EMAIL=
ALLOWED_ORIGIN=
