# Copy this file to .env and fill in the values. Never commit .env.
# Names starting with VITE_ are visible in the browser, so never put secrets in them.

# PostgreSQL connection string (local Postgres, Neon, Vercel Postgres, Supabase Postgres...)
DATABASE_URL=postgres://postgres:password@localhost:5432/lephas

# Random string of at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Public address of the site, used in email links. Leave empty locally.
SITE_URL=

# Email option 1: Gmail (or any SMTP server). Use a Google "app password", not your normal password.
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Email option 2: Resend (https://resend.com), needs your own domain. Used only if SMTP_USER is empty.
EMAIL_API_KEY=

# Who emails come from (optional; defaults to "Lephas Company Ltd <SMTP_USER>") and where team alerts go.
EMAIL_FROM=
TEAM_NOTIFICATION_EMAIL=

# Optional: RabbitMQ email queue (e.g. a free CloudAMQP instance, amqps://...).
# When set, the website puts emails on the queue and `npm run email-worker` sends them, with retries.
# If the queue cannot be reached, emails are sent directly instead. Leave empty to always send directly.
RABBITMQ_URL=
EMAIL_QUEUE=lephas.emails

# Optional: comma-separated list of allowed origins for form submissions, e.g. https://lephas.com
ALLOWED_ORIGIN=

# Only for the API tests: an EMPTY database that the tests can wipe.
TEST_DATABASE_URL=
# Optional, only for the queue test: a RabbitMQ the tests can use.
TEST_RABBITMQ_URL=
